# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_MODEL=gpt-4o

# Optional: Embedding model (for RAG / vector store)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Redis (for distributed memory / session persistence)
REDIS_URL=redis://localhost:6379

# Optional: Qdrant (for RAG vector store)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Optional: OpenTelemetry (for tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Optional: CoPaw/QwenPaw target path
COPAW_TARGET_PATH=/path/to/copaw/repo
